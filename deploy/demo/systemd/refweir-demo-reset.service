[Unit]
Description=Reset and reseed the hosted Refweir demo
Documentation=file:///opt/refweir/deploy/demo/README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Adjust to the deploy path and the user that can run docker.
WorkingDirectory=/opt/refweir/deploy/demo
ExecStart=/opt/refweir/deploy/demo/reset.sh
Environment=RESET_SKIP_BUILD=1
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
