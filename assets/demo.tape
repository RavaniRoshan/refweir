# Refweir 70-Second Demo Walkthrough
# Single binary, cold bootstrap, scoped capability leases, branch isolation, and policy merge
Output "assets/demo.gif"
Output "assets/demo.mp4"

Set Shell "bash"
Set FontSize 13
Set Width 1200
Set Height 680
Set Padding 16
Set Framerate 18
Set Theme "Catppuccin Macchiato"

Hide
Type "export PATH=$HOME/bin:/snap/bin:$PATH; cd /home/shiva/project-ref/refweir"
Enter
Sleep 1s
Show

Type "bash scripts/demo_walkthrough.sh"
Enter
Sleep 65s
